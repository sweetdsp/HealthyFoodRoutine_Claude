# Copy to .env and fill in. Never commit the real .env.

# Who gets the morning email
AMUTHA_EMAIL=amutha@example.com
FAMILY_EMAILS=husband@example.com, son@example.com, daughter@example.com

# Sending with Resend (default). Create an API key at https://resend.com/api-keys
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Must be on a domain you verified in Resend, e.g. kitchen@yourdomain.com.
# For a quick test use onboarding@resend.dev (Resend then only delivers to your own Resend account email).
EMAIL_FROM=Amutha's Kitchen <kitchen@yourdomain.com>

# Or send with SMTP instead (e.g. Gmail with an App Password): set EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=amutha.kitchen@gmail.com
# SMTP_PASSWORD=your-16-letter-app-password

# Greeting and timing (used by --daemon)
FAMILY_NAME=Amutha's family
TIMEZONE=Asia/Kolkata
SEND_TIME=05:30

# Optional AI chef note from Claude (leave the key empty to skip it)
ANTHROPIC_API_KEY=
AI_CHEF=on
AI_CHEF_MODEL=claude-opus-5-5
